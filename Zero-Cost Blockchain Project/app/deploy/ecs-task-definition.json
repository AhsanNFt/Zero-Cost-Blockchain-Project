{
  "family": "skillchain-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::REPLACE_ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::REPLACE_ACCOUNT_ID:role/skillchainTaskRole",
  "containerDefinitions": [
    {
      "name": "skillchain",
      "image": "REPLACE_WITH_ECR_IMAGE",
      "portMappings": [
        { "containerPort": 3000, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "REPLACE_SECRET_ARN_DATABASE_URL" },
        { "name": "GOOGLE_CLIENT_SECRET", "valueFrom": "REPLACE_SECRET_ARN_GOOGLE" },
        { "name": "OWNER_UNION_ID", "valueFrom": "REPLACE_SECRET_ARN_OWNER" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/skillchain",
          "awslogs-region": "REPLACE_REGION",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
