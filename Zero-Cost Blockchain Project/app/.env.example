# ── Backend ─────────────────────────────────────────────────────
GOOGLE_CLIENT_SECRET=       # Google OAuth 2.0 Client Secret

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=               # MySQL connection string (mysql://user:pass@host:port/db)

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_GOOGLE_CLIENT_ID=      # Google OAuth 2.0 Client ID
VITE_ALCHEMY_API_KEY=       # Alchemy API key used by the client bundle
VITE_CONTRACT_ADDRESS=      # Optional default contract address for the client

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=             # Google account ID of the admin user

# ── Pinata ──────────────────────────────────────────────────────
VITE_PINATA_API_KEY=
VITE_PINATA_SECRET_KEY=
VITE_PINATA_JWT=

# ── Optional ATS integrations ───────────────────────────────────
APP_URL=                    # Public application URL, e.g. https://app.example.com
GREENHOUSE_SECRET_KEY=
LEVER_WEBHOOK_SECRET=
LEVER_VERIFICATION_STAGE_ID=
